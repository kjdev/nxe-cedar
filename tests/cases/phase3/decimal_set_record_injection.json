{
    "description": "decimal values injected as set elements and record fields exercise nxe_cedar_set_add_decimal / nxe_cedar_record_add_decimal",
    "phase": 3,
    "tests": [
        {
            "name": "decimal_in_principal_record_field_eq",
            "description": "decimal placed as a record field is reachable via nested attribute access and equals a decimal literal",
            "policy": "permit (principal, action, resource) when { principal.profile.rate == decimal(\"1.23\") };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"},
                "principal_attrs": {
                    "profile": {
                        "rate": {"__extn": {"fn": "decimal", "arg": "1.23"}}
                    }
                }
            },
            "expected": "allow"
        },
        {
            "name": "decimal_in_context_record_field_lessThan",
            "description": "decimal record field works through lessThan via context",
            "policy": "permit (principal, action, resource) when { context.pricing.fee.lessThan(decimal(\"1.0\")) };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"},
                "context": {
                    "pricing": {
                        "fee": {"__extn": {"fn": "decimal", "arg": "0.5"}}
                    }
                }
            },
            "expected": "allow"
        },
        {
            "name": "decimal_in_resource_record_field_greaterThanOrEqual",
            "description": "decimal record field on resource compares via greaterThanOrEqual",
            "policy": "permit (principal, action, resource) when { resource.terms.price.greaterThanOrEqual(decimal(\"99.99\")) };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"},
                "resource_attrs": {
                    "terms": {
                        "price": {"__extn": {"fn": "decimal", "arg": "100.0"}}
                    }
                }
            },
            "expected": "allow"
        },
        {
            "name": "decimal_in_principal_set_contains_true",
            "description": "set attribute populated with decimals contains a matching decimal literal",
            "policy": "permit (principal, action, resource) when { principal.scores.contains(decimal(\"0.5\")) };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"},
                "principal_attrs": {
                    "scores": [
                        {"__extn": {"fn": "decimal", "arg": "0.5"}},
                        {"__extn": {"fn": "decimal", "arg": "0.75"}}
                    ]
                }
            },
            "expected": "allow"
        },
        {
            "name": "decimal_in_principal_set_contains_false",
            "description": "set attribute populated with decimals does not contain the queried decimal",
            "policy": "permit (principal, action, resource) when { principal.scores.contains(decimal(\"1.0\")) };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"},
                "principal_attrs": {
                    "scores": [
                        {"__extn": {"fn": "decimal", "arg": "0.5"}},
                        {"__extn": {"fn": "decimal", "arg": "0.75"}}
                    ]
                }
            },
            "expected": "deny"
        },
        {
            "name": "decimal_in_context_set_isEmpty_false",
            "description": "non-empty decimal set in context reports isEmpty() false",
            "policy": "permit (principal, action, resource) when { !context.rates.isEmpty() };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"},
                "context": {
                    "rates": [
                        {"__extn": {"fn": "decimal", "arg": "0.1"}}
                    ]
                }
            },
            "expected": "allow"
        },
        {
            "name": "decimal_in_record_then_set_contains_true",
            "description": "decimal stored in a record field whose sibling is a set of decimals, both reachable",
            "policy": "permit (principal, action, resource) when { principal.profile.scores.contains(decimal(\"0.25\")) && principal.profile.cap == decimal(\"1.0\") };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"},
                "principal_attrs": {
                    "profile": {
                        "cap": {"__extn": {"fn": "decimal", "arg": "1.0"}},
                        "scores": [
                            {"__extn": {"fn": "decimal", "arg": "0.25"}},
                            {"__extn": {"fn": "decimal", "arg": "0.5"}}
                        ]
                    }
                }
            },
            "expected": "allow"
        },
        {
            "name": "invalid_decimal_in_record_field_rejected",
            "description": "malformed decimal placed inside a record field is rejected at record-build time",
            "policy": "permit (principal, action, resource);",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"},
                "principal_attrs": {
                    "profile": {
                        "rate": {"__extn": {"fn": "decimal", "arg": "1.23456"}}
                    }
                }
            },
            "expected": "error"
        },
        {
            "name": "invalid_decimal_in_set_element_rejected",
            "description": "malformed decimal placed as a set element is rejected at set-build time",
            "policy": "permit (principal, action, resource);",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"},
                "principal_attrs": {
                    "scores": [
                        {"__extn": {"fn": "decimal", "arg": "0.5"}},
                        {"__extn": {"fn": "decimal", "arg": "9999999999999999.0"}}
                    ]
                }
            },
            "expected": "error"
        }
    ]
}
