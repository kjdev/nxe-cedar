{
    "description": "Scope constraint (==, in) tests",
    "tests": [
        {
            "name": "principal_eq_match",
            "description": "Allow when principal == matches",
            "policy": "permit (principal == User::\"alice\", action, resource);",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "principal_eq_no_match",
            "description": "Deny when principal == does not match",
            "policy": "permit (principal == User::\"bob\", action, resource);",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "deny"
        },
        {
            "name": "action_eq_match",
            "description": "Allow when action == matches",
            "policy": "permit (principal, action == Action::\"GET\", resource);",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "action_eq_no_match",
            "description": "Deny when action == does not match",
            "policy": "permit (principal, action == Action::\"POST\", resource);",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "deny"
        },
        {
            "name": "resource_eq_match",
            "description": "Allow when resource == matches",
            "policy": "permit (principal, action, resource == Endpoint::\"/api/data\");",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "all_scope_constraints",
            "description": "Allow only when all scope constraints match",
            "policy": "permit (principal == User::\"alice\", action == Action::\"GET\", resource == Endpoint::\"/api/data\");",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "principal_in_match",
            "description": "principal in entity_ref match allows",
            "policy": "permit (principal in User::\"alice\", action, resource);",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "principal_in_no_match",
            "description": "principal in entity_ref mismatch denies",
            "policy": "permit (principal in User::\"bob\", action, resource);",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "deny"
        },
        {
            "name": "resource_in_match",
            "description": "resource in entity_ref match allows",
            "policy": "permit (principal, action, resource in Endpoint::\"/api/data\");",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "resource_in_no_match",
            "description": "resource in entity_ref mismatch denies",
            "policy": "permit (principal, action, resource in Endpoint::\"/api/other\");",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "deny"
        },
        {
            "name": "action_in_entity_match",
            "description": "action in entity_ref match allows",
            "policy": "permit (principal, action in Action::\"GET\", resource);",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "all_in_constraints",
            "description": "all scopes with in constraints match",
            "policy": "permit (principal in User::\"alice\", action in Action::\"GET\", resource in Endpoint::\"/api/data\");",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        }
    ]
}
