{
    "description": "Basic permit policy tests",
    "tests": [
        {
            "name": "unconditional_permit_allows",
            "description": "Unconstrained permit allows all requests",
            "policy": "permit (principal, action, resource);",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "multiple_permits",
            "description": "With multiple permit policies, allow if any one matches",
            "policy": "permit (principal == User::\"bob\", action, resource);\npermit (principal == User::\"alice\", action, resource);",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        }
    ]
}
