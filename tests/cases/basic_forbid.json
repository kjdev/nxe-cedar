{
    "description": "Basic forbid policy tests",
    "tests": [
        {
            "name": "unconditional_forbid_denies",
            "description": "Unconstrained forbid denies all requests",
            "policy": "forbid (principal, action, resource);",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "deny"
        },
        {
            "name": "forbid_overrides_permit",
            "description": "forbid takes priority over permit (forbid-priority evaluation)",
            "policy": "permit (principal, action, resource);\nforbid (principal, action, resource);",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "deny"
        },
        {
            "name": "forbid_specific_overrides_general_permit",
            "description": "forbid for a specific user overrides a general permit",
            "policy": "permit (principal, action, resource);\nforbid (principal == User::\"alice\", action, resource);",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "deny"
        }
    ]
}
