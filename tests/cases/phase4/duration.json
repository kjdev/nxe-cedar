{
    "description": "duration extension type: parsing, units, sign, comparison, and conversions",
    "phase": 4,
    "tests": [
        {
            "name": "equal_units_hour_minutes",
            "description": "1h equals 60m",
            "policy": "permit (principal, action, resource) when { duration(\"1h\") == duration(\"60m\") };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "complex_multi_unit_milliseconds",
            "description": "all five units combine into the right millisecond total",
            "policy": "permit (principal, action, resource) when { duration(\"1d2h3m4s5ms\").toMilliseconds() == 93784005 };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "negative_less_than_positive",
            "description": "a negative duration is less than a positive one",
            "policy": "permit (principal, action, resource) when { duration(\"-1d\") < duration(\"1s\") };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "negative_less_than_zero",
            "description": "a negative duration is less than zero",
            "policy": "permit (principal, action, resource) when { duration(\"-10h\") < duration(\"0s\") };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "to_milliseconds_day",
            "description": "duration(1d).toMilliseconds() is 86400000",
            "policy": "permit (principal, action, resource) when { duration(\"1d\").toMilliseconds() == 86400000 };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "to_milliseconds_seconds_and_millis",
            "description": "4s100ms is 4100 milliseconds",
            "policy": "permit (principal, action, resource) when { duration(\"4s100ms\").toMilliseconds() == 4100 };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "to_seconds",
            "description": "duration(90s).toSeconds() is 90",
            "policy": "permit (principal, action, resource) when { duration(\"90s\").toSeconds() == 90 };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "to_minutes",
            "description": "duration(1d).toMinutes() is 1440",
            "policy": "permit (principal, action, resource) when { duration(\"1d\").toMinutes() == 1440 };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "to_hours",
            "description": "duration(1d).toHours() is 24",
            "policy": "permit (principal, action, resource) when { duration(\"1d\").toHours() == 24 };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "to_days",
            "description": "duration(36h).toDays() truncates to 1",
            "policy": "permit (principal, action, resource) when { duration(\"36h\").toDays() == 1 };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "negative_to_seconds_truncates_toward_zero",
            "description": "-1500ms toSeconds truncates toward zero to -1",
            "policy": "permit (principal, action, resource) when { duration(\"-1500ms\").toSeconds() == -1 };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "minutes_vs_milliseconds_disambiguation",
            "description": "m is minutes and ms is milliseconds",
            "policy": "permit (principal, action, resource) when { duration(\"5m\").toMilliseconds() == 300000 && duration(\"5ms\").toMilliseconds() == 5 };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "seconds_then_millis",
            "description": "3s5ms is 3005 milliseconds",
            "policy": "permit (principal, action, resource) when { duration(\"3s5ms\").toMilliseconds() == 3005 };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "allow"
        },
        {
            "name": "context_duration_attr_threshold",
            "description": "duration injected via context compared to a threshold",
            "policy": "permit (principal, action, resource) when { context.elapsed > duration(\"365d\") };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"},
                "context": {"elapsed": {"__extn": {"fn": "duration", "arg": "400d"}}}
            },
            "expected": "allow"
        },
        {
            "name": "out_of_order_units_invalid",
            "description": "units must be in descending order; 1h1d errors",
            "policy": "permit (principal, action, resource) when { duration(\"1h1d\") == duration(\"1h1d\") };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "deny"
        },
        {
            "name": "repeated_unit_invalid",
            "description": "a unit may appear at most once; 1h1h errors",
            "policy": "permit (principal, action, resource) when { duration(\"1h1h\") == duration(\"1h1h\") };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "deny"
        },
        {
            "name": "empty_string_invalid",
            "description": "an empty duration string errors",
            "policy": "permit (principal, action, resource) when { duration(\"\") == duration(\"0s\") };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "deny"
        },
        {
            "name": "missing_unit_invalid",
            "description": "a bare number without a unit errors",
            "policy": "permit (principal, action, resource) when { duration(\"5\") == duration(\"5ms\") };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"}
            },
            "expected": "deny"
        },
        {
            "name": "context_duration_attr_malformed_errors",
            "description": "injecting a malformed duration context attribute is an error",
            "policy": "permit (principal, action, resource) when { context.elapsed == duration(\"1d\") };",
            "request": {
                "principal": {"type": "User", "id": "alice"},
                "action": {"type": "Action", "id": "GET"},
                "resource": {"type": "Endpoint", "id": "/api/data"},
                "context": {"elapsed": {"__extn": {"fn": "duration", "arg": "1y"}}}
            },
            "expected": "error"
        }
    ]
}
